# Copy to .env (never commit). Cloud Run reads these from Secret Manager.

# Google AI Studio key (or leave empty and use Vertex AI via ADC)
GEMINI_API_KEY=

# Gemini model ID - confirm exact ID in AI Studio
GEMINI_MODEL=gemini-3.7-flash

# true to route Gemini through Vertex AI instead of the API key
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project ID
GOOGLE_CLOUD_PROJECT=

# asia-south1
GOOGLE_CLOUD_LOCATION=asia-south1

# Path to service-account JSON (local dev only; Cloud Run uses its SA)
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery dataset for this project
BIGQUERY_DATASET=cyclone_risk_network

# Cloud Storage bucket for media/artifacts
GCS_BUCKET=

# Firebase project ID (usually = GCP project)
FIREBASE_PROJECT_ID=

# Server-side Maps key (Geocoding/Routes)
MAPS_API_KEY=

# GCP project registered for Earth Engine
EARTH_ENGINE_PROJECT=

# Cloud Translation + Text-to-Speech REST key (restrict to those APIs) - optional, templates/browser TTS if empty
GOOGLE_CLOUD_API_KEY=

# SMS sandbox: Twilio test credentials as "ACCOUNT_SID:AUTH_TOKEN" - optional, simulated if empty
SMS_SANDBOX_KEY=
SMS_SANDBOX_FROM=
SMS_SANDBOX_TO=

# Messaging sandbox: Telegram bot token + chat id - optional, simulated if empty
MESSAGING_SANDBOX_TOKEN=
MESSAGING_SANDBOX_CHAT_ID=

# true = force every integration into labelled demo mode even when keys are set
FORCE_DEMO_MODE=false


# API
PORT=8050
CORS_ORIGINS=http://localhost:3050,http://localhost:3051
