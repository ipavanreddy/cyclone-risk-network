# Upload set for `gcloud builds submit` (deploy.sh). Deliberately does NOT include .gitignore:
# apps/*/.env.production (public NEXT_PUBLIC_* build values, generated by deploy.sh) must be uploaded.
.git
.gcloudignore
**/node_modules
**/.next
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
services/api/.data
data/cache
data/raw
docs
.env
**/.env.local
*.pem
**/service-account*.json
**/*-credentials.json
**/*.tsbuildinfo
.DS_Store
