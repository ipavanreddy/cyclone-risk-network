{
  "name": "cyclone-risk-network",
  "private": true,
  "scripts": {
    "dev:district-dashboard": "pnpm --filter district-dashboard dev",
    "dev:state-eoc-dashboard": "pnpm --filter state-eoc-dashboard dev",
    "dev:api": "cd services/api && uv run uvicorn app.main:app --reload --port 8050",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test:api": "cd services/api && uv run pytest -q"
  },
  "packageManager": "pnpm@11.13.0"
}
